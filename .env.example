# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Port (default 3000)
PORT="3000"

# Optional: MongoDB connection string (e.g. mongodb://localhost:27017/booai or mongodb+srv://...)
# If not provided, BOO AI uses the local persistent JSON file database at data/db.json.
MONGODB_URI=""

# Optional: Session encryption secret
JWT_SECRET="boo-ai-secret-key-change-in-production"

